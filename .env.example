# Copy to .env and adjust. Local demo values — never reuse for a real deploy.

# --- MariaDB ---
DB_ROOT_PASSWORD=change_me_root
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me_db

# --- WordPress site ---
WP_URL=http://localhost:8080
WP_TITLE="Linden Court Serviced Apartments"

# --- WordPress admin (local demo only) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_admin
WP_ADMIN_EMAIL=admin@example.com
